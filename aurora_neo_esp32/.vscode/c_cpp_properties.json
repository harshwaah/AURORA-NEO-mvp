{
  "configurations": [
    {
      "name": "ESP32",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:USERPROFILE}/Documents/Arduino/libraries/**",
        "${env:LOCALAPPDATA}/Arduino15/packages/esp32/hardware/esp32/**"
      ],
      "defines": [
        "ARDUINO=100",
        "ESP32"
      ],
      "compilerPath": "",
      "compilerArgs": [
        "-xc++"
      ],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ],
  "version": 4
}

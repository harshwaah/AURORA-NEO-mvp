{
  "files.associations": {
    "*.ino": "cpp"
  },
  "arduino.path": "${env:LOCALAPPDATA}/Programs/Arduino IDE",
  "arduino.commandPath": "Arduino IDE.exe",
  "arduino.logLevel": "info",
  "arduino.allowPDEFiletype": false,
  "arduino.enableUSBDetection": true,
  "clangd.fallbackFlags": [
    "-xc++",
    "-std=c++17",
    "-DARDUINO=100",
    "-DESP32",
    "-w"
  ]
}
